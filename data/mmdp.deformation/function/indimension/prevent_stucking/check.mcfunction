execute if score @s mmdp.deformation.in_dimension matches 0..157 if entity @s[tag=!mmdp.deformation.parkour] run scoreboard players add @s mmdp.deformation.in_dimension 1
execute if score @s mmdp.deformation.in_dimension matches 30 if entity @s[tag=!mmdp.deformation.parkour] run scoreboard players enable @s mmdp.deformation.evacuate
execute if score @s mmdp.deformation.in_dimension matches 158..159 if predicate mmdp.deformation:no_movement run scoreboard players add @s mmdp.deformation.in_dimension 1
execute if score @s mmdp.deformation.in_dimension matches 160 run tellraw @s [{"color":"gray","translate":"mmdp.deformation:chat.stucking_preventing.question"}," ",{"bold":true,"clickEvent":{"action":"run_command","value":"/trigger mmdp.deformation.evacuate"},"color":"blue","translate":"mmdp.deformation:chat.stucking_preventing.action.1"}," ",{"bold":true,"clickEvent":{"action":"run_command","value":"/trigger mmdp.deformation.evacuate set -1"},"color":"red","translate":"mmdp.deformation:chat.stucking_preventing.action.2"}]
execute if score @s mmdp.deformation.in_dimension matches 160 run scoreboard players set @s mmdp.deformation.in_dimension 0